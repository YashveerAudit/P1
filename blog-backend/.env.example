# Copy this file to .env and fill in your own values. Never commit .env.

# Required: MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/
MONGO_DB_NAME=blog_database

# Required: random secret (32+ chars) used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional: how long a login lasts, in minutes (default 720 = 12 hours)
# ACCESS_TOKEN_EXPIRE_MINUTES=720

# Optional: browser origins allowed to call the API (JSON list)
# CORS_ORIGINS=["http://localhost:5173"]

# Optional: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

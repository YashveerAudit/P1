# Copy this file to .env and fill in your own values. Never commit .env.

# Required: MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/
MONGO_DB_NAME=blog_database

# Optional: browser origins allowed to call the API (JSON list)
# CORS_ORIGINS=["http://localhost:5173"]

# Optional: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

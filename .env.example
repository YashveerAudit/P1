# Optional overrides for `docker compose up`. Copy to .env (git-ignored) to use.
# Everything has a working default, so this file is not needed for a local run.

# Random secret (32+ chars) used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# MONGO_DB_NAME=blog_database
# LOG_LEVEL=INFO
